<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Package visibility as Ruru's app manifest declares it (30694c2): MAIN intents and
        QUERY_ALL_PACKAGES. Its INTERNET and ACCESS_NETWORK_STATE permissions serve the VPN check
        of SettingProp, which this retrofit does not cover, so they are left out.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".RuruRetrofitApplication"
        android:allowBackup="false"
        android:label="Ruru retrofit"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".RuruRetrofitActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
