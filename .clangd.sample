# clangd configuration sample.
# Copy this file to `.clangd` and replace `<ANDROID_SDK_ROOT>` with your local Android SDK path.

CompileFlags:
  # 1. Point to the compilation database generated by Gradle/CMake for Android NDK build.
  CompilationDatabase: tamperprobe/.cxx/tools/debug/arm64-v8a

  # 2. Append flags to all files (including those in the compilation database).
  # We explicitly specify system include paths so clangd doesn't need to run --query-driver.
  Add:
    # include path for the C++ code itself
    - "-Itamperprobe/src/main/cpp"

    # NDK system include paths (C++ standard library must be placed before C standard library)
    - "-isystem"
    - "<ANDROID_SDK_ROOT>/ndk/27.0.12077973/toolchains/llvm/prebuilt/windows-x86_64/sysroot/usr/include/c++/v1"
    - "-isystem"
    - "<ANDROID_SDK_ROOT>/ndk/27.0.12077973/toolchains/llvm/prebuilt/windows-x86_64/sysroot/usr/include"
    - "-isystem"
    - "<ANDROID_SDK_ROOT>/ndk/27.0.12077973/toolchains/llvm/prebuilt/windows-x86_64/lib/clang/18/include"
    - "-isystem"
    - "<ANDROID_SDK_ROOT>/ndk/27.0.12077973/toolchains/llvm/prebuilt/windows-x86_64/sysroot/usr/include/aarch64-linux-android"

    # Preprocessor definitions
    - "-D_DEBUG"
    - "-D__ANDROID__"
    - "-D__ANDROID_API__=24"
    - "-DUNICODE"
    - "-D_UNICODE"

    # Target & Sysroot
    - "--target=aarch64-linux-android24"
    - "--sysroot=<ANDROID_SDK_ROOT>/ndk/27.0.12077973/toolchains/llvm/prebuilt/windows-x86_64/sysroot"

    # Language Standard
    - "-std=c++17"

  # Specify NDK compiler executable to resolve system headers correctly
  Compiler: <ANDROID_SDK_ROOT>/ndk/27.0.12077973/toolchains/llvm/prebuilt/windows-x86_64/bin/clang++.exe
